#!/usr/bin/env python3

from gtf_utils import keep_only_main_gtf_transcripts, calculate_cds_pos, gz_to_bgz, index_gtf
import argparse
from pathlib import Path
import pyranges1 as pr

parser = argparse.ArgumentParser()

parser.add_argument('--input_gtf', '-i', dest='input_gtf', required=True, help='Path to input GTF')
parser.add_argument('--remove_intermediate_files', '-rm', dest='rm_intermediate_files', default=1, type=int, help='Remove intermediate files: 0 or 1 (default: 1)')

args = parser.parse_args()

main_dir = Path(args.input_gtf).parent

# ==============================================================================================================
# Загружаем GTF в PyRanges
# ==============================================================================================================
gtf_pr = pr.read_gtf(args.input_gtf, duplicate_attr=True)

# ==============================================================================================================
# Оставляем только по одному основному транскрипту на каждый ген (MANE Select/Ensembl Canonical/other + MANE_Plus_Clinical).
# ==============================================================================================================
main_transcripts_pr = keep_only_main_gtf_transcripts(gtf_pr)

gtf_main_transcripts = set(main_transcripts_pr['transcript_id'])
gtf_main_gene_ids = set(main_transcripts_pr['gene_id'])

# ==============================================================================================================
# Создаем  отсортированный GTF файл включающий в себя все Feature, но только по main транскриптам.
# ==============================================================================================================
gtf_pr_main_transcripts = gtf_pr.query('(Feature == "gene" and gene_id in @gtf_main_gene_ids) or transcript_id in @gtf_main_transcripts')
gtf_pr_main_transcripts = gtf_pr_main_transcripts.sort_values(['Chromosome', 'Start', 'End'], kind='stable')

gtf_main_transcripts_filepath = args.input_gtf.removesuffix('.gz').removesuffix('.gtf') + '.main_transcripts.tmp.gtf.gz'
gtf_pr_main_transcripts.to_gtf(gtf_main_transcripts_filepath, compression='gzip')

gtf_main_transcripts_bgzipped_filepath = args.input_gtf.removesuffix('.gz').removesuffix('.gtf').removesuffix('.tmp') + '.main_transcripts.gtf.gz'
gz_to_bgz(gtf_main_transcripts_filepath, gtf_main_transcripts_bgzipped_filepath)
index_gtf(gtf_main_transcripts_bgzipped_filepath)

# ==============================================================================================================
# Оставляем CDS и stop_codon только по одному основному транскрипту (+ MANE_Plus_Clinical).
# ==============================================================================================================
cds_filepath = main_dir / 'cds.bed'

target_features = ['CDS', 'stop_codon']
cds_pr = gtf_pr_main_transcripts.query('Feature in @target_features')
cds_pr.to_bed(cds_filepath)

# ==============================================================================================================
# Расчитываем начало и конец CDS/stop_codon по cds позициям, а не только по хромосомным.
# ==============================================================================================================
cds_pos_filepath = main_dir / 'cds_pos.parquet'

cds_pr_pos = calculate_cds_pos(cds_pr)
cds_pr_pos_short = cds_pr_pos[['Chromosome', 'Start', 'End', 'Strand', 'transcript_id', 'cds_start', 'cds_end']]
cds_pr_pos_short.to_parquet(cds_pos_filepath, index=False, compression='snappy', engine='pyarrow')

# ==============================================================================================================
# Удаляем промежуточные файлы при необходимости.
# ==============================================================================================================
if args.rm_intermediate_files:
    Path(gtf_main_transcripts_filepath).unlink(missing_ok=True)