#!/usr/bin/env python3

from gtf_utils import filter_gtf_by_features, keep_only_main_gtf_transcripts, filter_gtf_by_transcripts, sort_gtf, index_gtf
import subprocess
import argparse
from pathlib import Path
import pyranges1 as pr

parser = argparse.ArgumentParser()

parser.add_argument('--input_gtf', '-i', dest='input_gtf', required=True, help='Path to input GTF')
parser.add_argument('--remove_intermediate_files', '-rm', dest='rm_intermediate_files', default=1, type=int, help='Remove intermediate files: 0 or 1 (default: 1)')

args = parser.parse_args()

main_dir = Path(args.input_gtf).parent

# ==============================================================================================================
# Создаем отдельные файлы для необходимых Features для снижения потребления оперативной памяти.
# Скорость обработки данных при этом не увеличивается.
# ==============================================================================================================
gene_sets_transcripts_filepath = args.input_gtf.removesuffix('.gz').removesuffix('.gtf') + '.transcripts.gtf.gz'
gene_sets_cds_filepath = args.input_gtf.removesuffix('.gz').removesuffix('.gtf') + '.cds.gtf.gz'

gene_sets_transcripts = filter_gtf_by_features(args.input_gtf, features=['transcript'], add_chr=True, output_gtf_filepath=gene_sets_transcripts_filepath)
gene_sets_cds = filter_gtf_by_features(args.input_gtf, features=['CDS', 'stop_codon'], add_chr=True, output_gtf_filepath=gene_sets_cds_filepath)

# ==============================================================================================================
# Оставляем только по одному основному транскрипту на каждый ген (MANE Select/Ensembl Canonical/other + MANE_Plus_Clinical).
# ==============================================================================================================
gtf_pr_main_transcripts = keep_only_main_gtf_transcripts(gene_sets_transcripts) # Содержит pr только cо строками транскриптов.
gtf_main_transcripts = set(gtf_pr_main_transcripts['transcript_id']) # Содержит set только с transcript_id.

# ==============================================================================================================
# Оставляем CDS и stop_codon только по одному основному транскрипту (+ MANE_Plus_Clinical).
# ==============================================================================================================
gtf_pr_cds = pr.read_gtf(gene_sets_cds)

# --------------------------------------------------------------------------------------------------------------
# Оставляем только по одному основному транскрипту для каждого гена (+ MANE_Plus_Clinical).
# --------------------------------------------------------------------------------------------------------------
gtf_pr_cds_single_transcript = gtf_pr_cds[gtf_pr_cds['transcript_id'].isin(gtf_main_transcripts)]

# --------------------------------------------------------------------------------------------------------------
# Оставляем только основные столбцы для BED.
# --------------------------------------------------------------------------------------------------------------
gtf_pr_cds_single_transcript_short = gtf_pr_cds_single_transcript[['Chromosome', 'Start', 'End']]
gtf_pr_cds_single_transcript_overlapped = (gtf_pr_cds_single_transcript_short
                                           .merge_overlaps()
                                           .sort_ranges())

# --------------------------------------------------------------------------------------------------------------
# Сохраняем в BED.
# --------------------------------------------------------------------------------------------------------------
cds_bed_filepath = main_dir / 'cds_overlapped.bed'
gtf_pr_cds_single_transcript_overlapped.to_bed(cds_bed_filepath)

# ==============================================================================================================
# Создаем  отсортированный GTF файл включающий в себя все Feature, но только по main транскриптам.
# ==============================================================================================================
gtf_single_transcripts_filepath = args.input_gtf.removesuffix('.gz').removesuffix('.gtf') + '.single_transcripts.gtf.gz'
filter_gtf_by_transcripts(args.input_gtf, gtf_single_transcripts_filepath, gtf_main_transcripts)

gtf_single_transcripts_sorted_filepath = gtf_single_transcripts_filepath.removesuffix('.gz').removesuffix('.gtf') + '.sorted.gtf.gz'
sort_gtf(gtf_single_transcripts_filepath, gtf_single_transcripts_sorted_filepath)

index_gtf(gtf_single_transcripts_sorted_filepath)

# ==============================================================================================================
# Удаляем промежуточные файлы при необходимости.
# ==============================================================================================================
if args.rm_intermediate_files:
    Path(gene_sets_cds).unlink(missing_ok=True)
    Path(gene_sets_transcripts).unlink(missing_ok=True)
    Path(gtf_single_transcripts_filepath).unlink(missing_ok=True)